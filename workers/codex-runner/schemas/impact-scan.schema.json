{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "touchedAreas": { "type": "array", "items": { "type": "string" } },
    "hiddenDependencies": { "type": "array", "items": { "type": "string" } },
    "likelyTestSurface": { "type": "array", "items": { "type": "string" } },
    "migrationHazards": { "type": "array", "items": { "type": "string" } },
    "operationalRisks": { "type": "array", "items": { "type": "string" } },
    "estimatedComplexity": { "type": "string", "enum": ["low", "medium", "high"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": [
    "summary",
    "touchedAreas",
    "hiddenDependencies",
    "likelyTestSurface",
    "migrationHazards",
    "operationalRisks",
    "estimatedComplexity",
    "confidence"
  ]
}
